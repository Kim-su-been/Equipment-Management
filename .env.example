# Copy to .env and change the password before sharing the server.
ADMIN_PASSWORD=replace-with-a-local-password
# Optional project-manager passwords (leave empty to disable those logins).
SFA_MANAGER_PASSWORD=
GW_MANAGER_PASSWORD=
API_HOST=127.0.0.1
API_PORT=3001
WEB_PORT=5173
# For production invite URLs, set the externally reachable service origin.
# PUBLIC_BASE_URL=https://readyboard.example.com
# SECURE_COOKIES=true
# Keep this database and invitation.key together when backing up.
DB_PATH=./data/readyboard.sqlite
INVITE_TTL_HOURS=72
SEED_DEMO=false
# Optional: fixed key from your secret store; do not rotate without revoking invitations.
INVITE_ENCRYPTION_KEY=
# Optional AI mapper. Without a key the UI explicitly uses manual/rule candidates.
OPENAI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini

# Mail review: default fixture inbox. Real IMAP is opt-in after confirming the provider supports it.
MAIL_PROVIDER=mock
# IMAP uses TLS, EXAMINE/readOnly and BODY.PEEK; never marks or moves messages.
MAIL_IMAP_HOST=
MAIL_IMAP_PORT=993
MAIL_IMAP_USER=
MAIL_IMAP_PASSWORD=
# Alternative to password: a provider-issued OAuth access token with mailbox read scope.
MAIL_IMAP_ACCESS_TOKEN=
# Empty values use PMO/인력요청 for mock, INBOX for IMAP. PMO can change folder/text scope in the UI.
MAIL_FOLDER=
MAIL_SEARCH=
MAIL_SINCE=
