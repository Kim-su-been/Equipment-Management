{
  "name": "readyboard-prototype",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "preview": "node server/index.mjs",
    "test": "node --test tests/*.test.js",
    "test:browser": "playwright test",
    "format": "prettier --write src tests *.js *.json index.html README.md",
    "preview:static": "node server/index.mjs",
    "export:html": "node scripts/export-html.mjs",
    "build:forms": "node scripts/build-document-templates.mjs",
    "start": "node server/index.mjs",
    "export:review": "node scripts/review/generate.mjs",
    "export:server-html": "node scripts/export-server-html.mjs",
    "test:html": "node tests/review-html.mjs && node tests/offline-html.mjs"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "exceljs": "^4.4.0",
    "imapflow": "^1.7.8",
    "lucide-react": "^0.468.0",
    "mailparser": "^3.14.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@vitejs/plugin-react": "^4.5.0",
    "prettier": "^3.9.10",
    "vite": "^7.0.0"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
